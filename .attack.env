NODE_NUM=4
NODE_LEAST_ID=0
# Attack experiment: node1 floods the ordering layer while participating in HotStuff;
# node0, node2, and node3 run docker_node normally.
# ======= Attack parameters ========
ADVERSARY_MODE=smrol            # pompe/smrol
CLIENT_ORDERING_MODE=smrol      # pompe/smrol
ATTACK_SLEEP_MICROS=100
POMPE_ATTACK_WORKERS=4          # concurrent senders inside the single Byzantine process
ATTACK_REPORT_INTERVAL_SECS=10 # compact rate report; no per-message logging
ATTACK_START_DELAY_MS=2000      # start after honest ordering listeners are ready
HOTSTUFF_START_DELAY_SECS=20
ADVERSARY_PAYLOAD_BYTES=500
# ==================================
POMPE_ENABLE=true
POMPE_BATCH_SIZE=1

TARGET_TPS=400 # aggregate client target; current sender rate is controlled by batch settings
ORDERING_BATCH_SIZE=1
CLIENT_BATCH_SIZE_CONSTANT=3
CLIENT_TOTAL_TX=1000
# node1 is Byzantine at the ordering layer and does not accept client submissions.
CLIENT_EXCLUDED_NODE_IDS=1
CLIENT_LOG_LEVEL=info
CLIENT_LOG_INDIVIDUAL_LATENCY=false
CLIENT_LATENCY_WARMUP_SECS=5
CLIENT_LATENCY_REPORT_INTERVAL=100

POMPE_STABLE_PERIOD_MS=50
POMPE_LIVENESS_DELTA_MS=10
POMPE_LEADER_NODE_ID=0
HS_MAX_VIEW_TIME_MS=500
# Broadcast PhaseVotes to keep local four-node vote collection robust under load.
HS_BROADCAST_PHASE_VOTES=1
APP_BLOCK_MAX_TX=180000
NODE_PORT=10000
NODE_HOSTS=node0:node0,node1:node1,node2:node2,node3:node3
LOG_LEVEL=warn
# ,runtime=trace,tokio=trace
#,hotstuff_runner::smrol=debug,hotstuff_runner::smrol::network=debug,hotstuff_runner::smrol::manager=debug#,runtime=trace,tokio=trace
ENABLE_RUNTIME_PROFILING=0
ENABLE_TOKIO_CONSOLE=0
SMROL_DISABLE_MULTISIG=0
SMROL_DISABLE_METRICS=0
SMROL_MAX_PENDING_SEQ_REQUESTS=2000 # per authenticated sender
SMROL_MAX_SEQ_DISTANCE=200

# CPU affinity configuration: pin general workloads to cores 0-1, keep verification on 2-3
SMROL_TOKIO_CORES=0-1
SMROL_RT_CORES=0-1
TOKIO_NETWORK_RT_CORES=0-1
POMPE_RT_CORES=0-1
SMROL_PNFIFO_THRESHOLD_WORKERS=2
SMROL_PNFIFO_THRESHOLD_CORES=0-1
SMROL_SEQ_OFFLOAD_WORKERS=2
SMROL_SEQ_OFFLOAD_CORES=0-1
SMROL_MULTISIG_COMBINE_CORES=0-1
SMROL_MULTISIG_VERIFY_MEDIAN_CORES=2-3
SMROL_MULTISIG_VERIFY_MEDIAN_WORKERS=2
SMROL_MULTISIG_VERIFY_COMBINED_CORES=2-3
SMROL_MULTISIG_VERIFY_COMBINED_WORKERS=2
